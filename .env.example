# Patch Sentinel — .env.example
# Copy to `.env` (mode 600, gitignored) only if you want one of the two overrides below.
#
# NOTHING is required: the scan is read-only, registry lookups are anonymous, and remote hosts use
# your own SSH agent. The plugin reads no secret and has no credential path (see SECURITY.md).

# Optional — the host inventory, when you would rather set it here than in the plugin settings
# (`plugins.entries.patch-sentinel.settings.hosts` in config.yaml, which wins where both are set).
# `label=ssh-target`; `local` means the machine Hermes runs on. Left unset, only this machine.
# PATCH_SENTINEL_HOSTS=beelink=local,vps=webasix

# Optional — where `last_scan.json`, `integrity.json` and the apply receipts are written, mode 700.
# Default: $HERMES_HOME/patch-sentinel. Absolute path only.
# PATCH_SENTINEL_DATA=/home/you/.hermes/patch-sentinel
