# Patch Sentinel — .env.example
# Copy to `.env` (mode 600, gitignored). Nothing is required for the read-only scan.

# Optional — a read-only container-registry token, so image digest checks and pulls are not
# rate-limited (Docker Hub anonymous: 100 pulls / 6h per IP; authenticated: 200). Scope it
# `repo:read` and nothing else. Declared in plugin.yaml as optional_env.
# DOCKER_HUB_USER=
# DOCKER_HUB_TOKEN=

# Optional — the host inventory. Remote hosts are reached over SSH with your own agent key; no
# secret lives here. Left unset, the plugin scans only the machine Hermes runs on.
# PATCH_SENTINEL_HOSTS=this-box=local,vps=webasix

# Optional — where scan receipts are written (default: ./data, gitignored).
# PATCH_SENTINEL_DATA=./data
