# .gitignore — Patch Sentinel (a Hermes plugin)

# Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
credentials.json
credentials.*.json
*.pem
*.key
*.pfx
*.p12
*.jks
secrets/
*.secret

# Dependencies
.venv/
venv/
node_modules/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Scan receipts and the SQLite store (local state, never published)
data/
*.db
*.sqlite
*.sqlite3

# IDE / OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Runtime
logs/
*.log
tmp/
temp/
*.pid

# Backups
*.bak
*.backup
backups/
